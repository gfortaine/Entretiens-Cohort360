# =============================================================================
# Cohort360 Medical API - Environment Variables
# Django 5.2 LTS Configuration
# =============================================================================
# Copy this file to .env and fill in the values

# Django Core Settings
# -----------------------------------------------------------------------------
# Generate a new secret key for production: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=your-production-secret-key-here

# Set to 0 in production
DJANGO_DEBUG=1

# Comma-separated list of allowed hosts
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# CSRF trusted origins (required for Django 5.2+)
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000


# CORS Configuration
# -----------------------------------------------------------------------------
# Origins allowed to make cross-origin requests (frontend URL)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000


# Database Configuration (Optional - defaults to SQLite)
# -----------------------------------------------------------------------------
# For PostgreSQL (recommended for production):
# DATABASE_URL=postgres://user:password@localhost:5432/cohort360


# Logging Configuration
# -----------------------------------------------------------------------------
# LOG_LEVEL=INFO
